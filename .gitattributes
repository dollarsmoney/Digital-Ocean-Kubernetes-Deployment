# Normalize to LF in the repository.
* text=auto eol=lf

# These are consumed by Linux tooling (bash in GitHub Actions, Docker builds,
# the kubelet). CRLF in a shell block produces "$'\r': command not found",
# which is a genuinely confusing failure to debug from a CI log.
*.sh      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.conf    text eol=lf
Dockerfile text eol=lf

# Generated; keep it out of diffs and language stats.
package-lock.json -diff linguist-generated=true
